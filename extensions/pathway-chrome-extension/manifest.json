{
  "manifest_version": 3,
  "name": "Airnet Pathway - Floating Dossier",
  "version": "1.1.0",
  "description": "Access your Airnet Customer Pathway floating screen directly on any website or tab (Seva Sindhu, Nadakacheri, etc.) with resizable window and live customer data.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:5001/*",
    "http://127.0.0.1:5001/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Airnet Pathway Floating Dossier"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-pathway": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "Toggle Airnet Pathway on current website"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
